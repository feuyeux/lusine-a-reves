{
  "name": "lusine-a-reves-meta-builder",
  "version": "0.1.0",
  "private": true,
  "description": "A generic presentation-to-PPTX and narrated Remotion video builder",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "check": "node scripts/validate-deck.mjs",
    "manifest": "node scripts/build-audio-manifest.mjs",
    "voiceover": "node scripts/generate-voiceover.mjs",
    "test": "node --test test/*.test.mjs",
    "export:pptx": "node scripts/export-pptx.mjs",
    "render": "node scripts/render.mjs",
    "build": "remotion bundle",
    "lint": "eslint src scripts test && tsc --noEmit"
  },
  "dependencies": {
    "@remotion/captions": "4.0.515",
    "@remotion/cli": "4.0.515",
    "@remotion/media": "4.0.515",
    "@remotion/media-utils": "4.0.515",
    "pptxgenjs": "3.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/node": "22.15.21",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/web": "0.0.172",
    "eslint": "9.19.0",
    "globals": "15.14.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.22.0"
  }
}
