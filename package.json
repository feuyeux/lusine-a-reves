{
  "name": "lusine-a-reves-meta-builder",
  "version": "0.1.0",
  "private": true,
  "description": "A generic presentation-to-PPTX and narrated Remotion video builder",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node core/scripts/studio.mjs",
    "check": "node core/scripts/validate-deck.mjs",
    "manifest": "node core/scripts/build-audio-manifest.mjs",
    "voiceover": "node core/scripts/generate-voiceover.mjs",
    "install:edge-tts": "bash core/scripts/install-edge-tts.sh",
    "install:qwen3-tts": "bash core/scripts/install-qwen3-tts.sh",
    "voiceover:edge": "node core/scripts/run-edge-tts.mjs",
    "voiceover:qwen3": "node core/scripts/run-qwen3-tts.mjs",
    "test": "node --test core/test/*.test.mjs",
    "export:pptx": "node core/scripts/export-pptx.mjs",
    "render": "node core/scripts/render.mjs",
    "build": "remotion bundle core/src/index.ts",
    "lint": "eslint core/src core/scripts core/test && tsc --noEmit"
  },
  "dependencies": {
    "@remotion/captions": "4.0.515",
    "@remotion/cli": "4.0.515",
    "@remotion/media": "4.0.515",
    "pptxgenjs": "3.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@types/node": "22.15.21",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/web": "0.0.172",
    "eslint": "9.19.0",
    "globals": "15.14.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.22.0"
  }
}
